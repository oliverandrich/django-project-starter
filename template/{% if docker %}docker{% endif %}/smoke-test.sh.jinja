#!/bin/sh
# Starts docker/compose.yaml with the image {{ project_name }}:latest and checks every process.
# CI runs it after building the image. It uses throwaway settings in a temporary env file and
# a project name of its own, so it leaves docker/.env and a running deployment alone.
set -eu

cd "$(dirname "$0")"
APP_ENV_FILE="$(mktemp)"
export APP_ENV_FILE
compose="docker compose -f compose.yaml --project-name {{ project_name }}-smoke --env-file $APP_ENV_FILE"

finish() {
    status=$?
    if [ "$status" -ne 0 ]; then
        $compose logs
    fi
    $compose down --volumes >/dev/null 2>&1
    rm -f "$APP_ENV_FILE"
    exit "$status"
}
trap finish EXIT

{
    echo "SECRET_KEY=$(openssl rand -hex 32)"
    echo "ALLOWED_HOSTS=app.example.org"
{% if database == "postgresql" %}
    echo "POSTGRES_PASSWORD=$(openssl rand -hex 16)"
{% endif %}
{% if site_url %}
    echo "SITE_URL=https://app.example.org"
{% endif %}
{% if "magic_link" in login %}
    echo "EMAIL_URL=smtp://mail.example.org?_default_from_email=app@example.org"
{% endif %}
{% if "microsoft" in login %}
    echo "ENTRA_TENANT_ID=11111111-1111-1111-1111-111111111111"
    echo "ENTRA_CLIENT_ID=22222222-2222-2222-2222-222222222222"
    echo "ENTRA_CLIENT_SECRET=not-secret"
{% endif %}
{% if "microsoft" in login and "magic_link" in login %}
    echo "INTERNAL_EMAIL_DOMAINS=example.org"
{% endif %}
} >"$APP_ENV_FILE"

$compose up --no-build --detach --wait

curl --fail --silent --show-error http://127.0.0.1:8000/health/ready
echo
# The proxy sends X-Forwarded-Proto; without it, the app redirects to HTTPS.
curl --fail --silent --show-error --output /dev/null \
    --header "Host: app.example.org" --header "X-Forwarded-Proto: https" \
{% if login %}
    http://127.0.0.1:8000/login/
{% else %}
    http://127.0.0.1:8000/
{% endif %}
{% if background_tasks %}
# A process that exits at start shows as running between restarts. Wait, then count restarts.
sleep 10
for service in worker scheduler; do
    state="$(docker inspect --format '{% raw %}{{.State.Running}} {{.RestartCount}}{% endraw %}' "$($compose ps --quiet "$service")")"
    if [ "$state" != "true 0" ]; then
        echo "$service is not running steadily: running, restarts = $state" >&2
        exit 1
    fi
done
{% endif %}
echo "The compose example runs."
