"""Tasks of the project. `manage.py crontask` imports this module to register `@cron` schedules."""

from datetime import timedelta

import structlog
from crontask import cron
from django.conf import settings
from django.core.management import call_command
from django.db import transaction
from django.tasks import DEFAULT_TASK_BACKEND_ALIAS, TaskResultStatus, task, task_backends
from django.utils import timezone
from django_tasks_db import DatabaseBackend
from django_tasks_db.models import DBTaskResult

logger = structlog.get_logger(__name__)


class StaleTaskError(Exception):
    """A task stayed RUNNING longer than TASKS_STALE_AFTER_MINUTES."""


def uses_database_backend() -> bool:
    """django-tasks-db's commands and models serve only its own backend."""
    return isinstance(task_backends[DEFAULT_TASK_BACKEND_ALIAS], DatabaseBackend)


@cron("0 3 * * *")
@task
def prune_task_results() -> None:
    """Delete finished task results older than two weeks from every queue."""
    if uses_database_backend():
        call_command("prune_db_task_results", queue_name="*", min_age_days=14, verbosity=0)


@cron("*/15 * * * *")
@task
def fail_stale_tasks() -> None:
    """Mark tasks FAILED that are RUNNING longer than settings.TASKS_STALE_AFTER_MINUTES.

    A worker killed during a task leaves its row RUNNING. django-tasks-db never resumes it.
    This task does not requeue it either.
    A task that is still alive overwrites FAILED when it ends.
    """
    if not uses_database_backend():
        return
    limit = settings.TASKS_STALE_AFTER_MINUTES
    stale = DBTaskResult.objects.filter(
        backend_name=DEFAULT_TASK_BACKEND_ALIAS,
        status=TaskResultStatus.RUNNING,
        started_at__lt=timezone.now() - timedelta(minutes=limit),
    )
    # The row locks keep a worker from saving its result between the read and set_failed().
    with transaction.atomic():
        rows = list(stale.select_for_update(skip_locked=True))
        for row in rows:
            row.set_failed(StaleTaskError(f"RUNNING for more than {limit} minutes"))
    for row in rows:
        logger.warning("stale_task_failed", task_id=str(row.id), task_path=row.task_path)
{% if live_updates %}


@cron("17 * * * *")
@task
def prune_stream_events() -> None:
    """Delete server-sent events older than PG_SSE["RETENTION_HOURS"], the reach of replay."""
    call_command("prune_stream_events", verbosity=0)
