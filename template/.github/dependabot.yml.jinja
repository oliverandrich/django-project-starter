version: 2
updates:
  - package-ecosystem: uv
    directory: /
    schedule:
      interval: weekly
  - package-ecosystem: pre-commit
    directory: /
    schedule:
      interval: weekly
  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly
{% if docker %}
  - package-ecosystem: docker
    directory: /docker
    schedule:
      interval: weekly
{% endif %}
