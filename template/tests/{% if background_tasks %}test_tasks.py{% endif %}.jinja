class TaskLoggingTest(SimpleTestCase):
    """django-structlog's hand-over of the request context to the tasks a request enqueues."""

    def test_task_context_outlives_a_queue_of_five_minutes(self):
        cache = evaluate_settings()["CACHES"]["django_structlog"]
        self.assertGreaterEqual(cache["TIMEOUT"], 60 * 60)

    def test_the_scheduler_lock_renewal_stays_out_of_the_log(self):
        # django-crontask extends its lock every few seconds through an APScheduler job.
        loggers = evaluate_settings()["LOGGING"]["loggers"]
        self.assertEqual(loggers["apscheduler"]["level"], "WARNING")

    def test_task_bookkeeping_logs_only_failures(self):
        loggers = evaluate_settings()["LOGGING"]["loggers"]
        self.assertEqual(loggers["django_structlog.tasks.receivers"]["level"], "WARNING")


class TasksSettingTest(SimpleTestCase):
    def test_database_backend_by_default(self):
        tasks = evaluate_settings()["TASKS"]
        self.assertEqual(tasks["default"]["BACKEND"], DATABASE)

    def test_tasks_backend_selects_the_backend(self):
        tasks = evaluate_settings(TASKS_BACKEND=IMMEDIATE)["TASKS"]
        self.assertEqual(tasks["default"]["BACKEND"], IMMEDIATE)

    def test_a_task_counts_as_stale_after_an_hour_by_default(self):
        self.assertEqual(evaluate_settings()["TASKS_STALE_AFTER_MINUTES"], 60)

    def test_tasks_stale_after_minutes_sets_the_limit(self):
        configured = evaluate_settings(TASKS_STALE_AFTER_MINUTES="240")
        self.assertEqual(configured["TASKS_STALE_AFTER_MINUTES"], 240)

    def test_tasks_stale_after_minutes_rejects_zero(self):
        # A limit of 0 would fail every running task.
        with self.assertRaises(EnvValidationError):
            evaluate_settings(TASKS_STALE_AFTER_MINUTES="0")


class SuiteSettingsTest(SimpleTestCase):
    def test_tasks_run_immediately(self):
        # A project with TASKS_BACKEND in .env would otherwise queue tasks no test runs.
        with override_settings(TASKS={"default": {"BACKEND": DATABASE}}), suite_settings():
            self.assertIsInstance(task_backends["default"], ImmediateBackend)


@override_settings(TASKS={"default": {"BACKEND": DATABASE}})
class PruneTaskResultsTest(TestCase):
    def make_result(self, *, age: timedelta) -> DBTaskResult:
        return baker.make(
            DBTaskResult,
            status=TaskResultStatus.SUCCESSFUL,
            finished_at=timezone.now() - age,
            backend_name="default",
            queue_name="reports",
        )

    def test_deletes_results_older_than_two_weeks_in_every_queue(self):
        old = self.make_result(age=timedelta(days=15))
        recent = self.make_result(age=timedelta(days=1))
        prune_task_results.call()
        remaining = DBTaskResult.objects.values_list("id", flat=True)
        self.assertNotIn(old.id, remaining)
        self.assertIn(recent.id, remaining)

    @override_settings(TASKS={"default": {"BACKEND": IMMEDIATE}})
    def test_does_nothing_without_the_database_backend(self):
        prune_task_results.call()

    def test_runs_daily(self):
        names = [job.name for job in scheduler.get_jobs()]
        self.assertIn(prune_task_results.name, names)


@override_settings(TASKS={"default": {"BACKEND": DATABASE}}, TASKS_STALE_AFTER_MINUTES=60)
class FailStaleTasksTest(TestCase):
    def make_result(
        self, status: TaskResultStatus, *, started: timedelta, backend: str = "default"
    ) -> str:
        """Enqueue a task and move it to `status`, started `started` ago."""
        result = prune_task_results.enqueue()
        DBTaskResult.objects.filter(id=result.id).update(
            status=status, started_at=timezone.now() - started, backend_name=backend
        )
        return result.id

    def status(self, result_id: str) -> str:
        return DBTaskResult.objects.get(id=result_id).status

    def test_fails_a_task_running_longer_than_the_limit(self):
        stale = self.make_result(TaskResultStatus.RUNNING, started=timedelta(minutes=61))
        fail_stale_tasks.call()
        result = prune_task_results.get_result(stale)
        self.assertEqual(result.status, TaskResultStatus.FAILED)
        self.assertIsNotNone(result.finished_at)
        self.assertIs(result.errors[0].exception_class, project_tasks.StaleTaskError)

    def test_leaves_a_task_running_within_the_limit(self):
        running = self.make_result(TaskResultStatus.RUNNING, started=timedelta(minutes=59))
        fail_stale_tasks.call()
        self.assertEqual(self.status(running), TaskResultStatus.RUNNING)

    def test_leaves_tasks_that_do_not_run(self):
        ready = prune_task_results.enqueue().id
        done = self.make_result(TaskResultStatus.SUCCESSFUL, started=timedelta(days=1))
        fail_stale_tasks.call()
        self.assertEqual(self.status(ready), TaskResultStatus.READY)
        self.assertEqual(self.status(done), TaskResultStatus.SUCCESSFUL)

    @override_settings(TASKS_STALE_AFTER_MINUTES=120)
    def test_the_limit_comes_from_the_setting(self):
        running = self.make_result(TaskResultStatus.RUNNING, started=timedelta(minutes=90))
        fail_stale_tasks.call()
        self.assertEqual(self.status(running), TaskResultStatus.RUNNING)

    def test_leaves_the_tasks_of_other_backends(self):
        other = self.make_result(
            TaskResultStatus.RUNNING, started=timedelta(minutes=61), backend="slow"
        )
        fail_stale_tasks.call()
        self.assertEqual(self.status(other), TaskResultStatus.RUNNING)

    def test_does_nothing_without_the_database_backend(self):
        stale = self.make_result(TaskResultStatus.RUNNING, started=timedelta(minutes=61))
        with self.settings(TASKS={"default": {"BACKEND": IMMEDIATE}}):
            fail_stale_tasks.call()
        self.assertEqual(self.status(stale), TaskResultStatus.RUNNING)

    def test_runs_every_fifteen_minutes(self):
        jobs = {job.name: job for job in scheduler.get_jobs()}
        trigger = jobs[fail_stale_tasks.name].trigger
        fields = {field.name: str(field) for field in trigger.fields}
        self.assertEqual(fields["minute"], "*/15")
