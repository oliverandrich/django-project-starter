import re

from django.contrib.auth import get_user_model
from django.contrib.auth.hashers import make_password
from django.core import mail
from django.core.cache import cache
from django.urls import reverse
from model_bakery import baker

from tests.browser import BrowserTestCase


class MagicLinkLoginTest(BrowserTestCase):
    def test_a_mailed_link_logs_in(self):
        cache.clear()
        user = baker.make(
            get_user_model(), email="kim@customer.example", password=make_password(None)
        )
        # Links start with SITE_URL, here the live server.
        with self.settings(SITE_URL=self.live_server_url):
            self.page.goto(self.url(reverse("login")))
            self.page.get_by_label("Email address").fill("kim@customer.example")
            self.page.get_by_role("button", name="Email me a login link").click()
            self.page.wait_for_url(self.url(reverse("magic_link_sent")))

        (message,) = mail.outbox
        match = re.search(r"https?://\S+", str(message.body))
        assert match, message.body
        self.page.goto(match.group(0))
        self.page.get_by_role("button", name="Log in").click()
        self.page.wait_for_url(self.url("/"))
        self.assertEqual(self.logged_in_user(), user)
