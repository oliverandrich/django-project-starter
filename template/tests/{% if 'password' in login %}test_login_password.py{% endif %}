from django.contrib.auth import get_user_model
from django.contrib.auth.hashers import make_password
from django.test import TestCase
from django.urls import reverse
from django.utils.html import escape
from model_bakery import baker


class PasswordLoginTest(TestCase):
    def setUp(self):
        self.user = baker.make(
            get_user_model(), username="ada", password=make_password("secret-enough")
        )

    def test_the_page_shows_the_form(self):
        self.assertContains(self.client.get(reverse("login")), 'name="password"')

    def test_the_right_password_logs_in(self):
        response = self.client.post(
            reverse("login"), {"username": "ada", "password": "secret-enough"}
        )
        self.assertRedirects(response, "/", fetch_redirect_response=False)
        self.assertEqual(int(self.client.session["_auth_user_id"]), self.user.pk)

    def test_a_wrong_password_shows_an_error(self):
        response = self.client.post(reverse("login"), {"username": "ada", "password": "wrong"})
        self.assertEqual(response.status_code, 200)
        [error] = response.context["form"].non_field_errors()
        self.assertContains(response, escape(error))
        self.assertNotIn("_auth_user_id", self.client.session)
