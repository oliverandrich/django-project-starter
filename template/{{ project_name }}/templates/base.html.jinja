{% raw %}{% load django_browser_reload django_htmx tailwind_cli %}
<!DOCTYPE html>
<html lang="{{ LANGUAGE_CODE }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="csrf-token" content="{{ csrf_token }}">
        <title>{% block title %}Home{% endblock %}</title>
        {% tailwind_css %}
        {% comment %}
            htmx 4, vendored by `mise run update-htmx`.
            Without defer, htmx starts at DOMContentLoaded, after hx-sse registered.
            Deferred, htmx starts in a setTimeout that can run before hx-sse arrives.
            An hx-sse:connect element then never opens its stream.
        {% endcomment %}
        <script src="{% static 'vendor/htmx/htmx.min.js' %}"></script>
        <script src="{% static 'vendor/htmx/ext/hx-sse.min.js' %}"></script>
        {% django_htmx_script %}
        {# A file, not an inline script: the Content Security Policy blocks inline code. #}
        <script src="{% static 'js/csrf.js' %}"></script>
        {% django_browser_reload_script %}
        {% block extra_head %}{% endblock %}
    </head>
{% endraw %}{% if daisy_ui %}
    <body hx-boost:inherited="true">
{% else %}
    <body class="bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100" hx-boost:inherited="true">
{% endif %}
{% raw %}        {% block content %}
            <div class="min-h-screen flex justify-center items-center">
                <div class="text-5xl">
                    Django + Tailwind + HTMX = ❤️
                </div>
            </div>
        {% endblock content %}
        {% block extra_js %}{% endblock %}
    </body>
</html>
{% endraw %}
