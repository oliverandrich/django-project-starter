{% raw %}name: CI

on:
  push:
    branches: [main]
  pull_request:

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  checks:
    runs-on: ubuntu-latest
{% endraw %}{% if database == "postgresql" %}{% raw %}    services:
      postgres:
        image: postgres:18
        env:
          POSTGRES_PASSWORD: postgres
        ports:
          - 5432:5432
        options: >-
          --health-cmd pg_isready
          --health-interval 5s
          --health-timeout 5s
          --health-retries 10
{% endraw %}{% endif %}{% raw %}    env:
      # A fresh checkout has no .env, and settings.E001 refuses an empty key outside DEBUG.
      SECRET_KEY: ci-only-not-secret
{% endraw %}{% if database == "postgresql" %}{% raw %}      DATABASE_URL: postgres://postgres:postgres@localhost:5432/postgres
{% endraw %}{% endif %}{% raw %}    steps:
      - uses: actions/checkout@v7
      - uses: jdx/mise-action@v5
      - uses: actions/cache@v6
        with:
          path: ~/.cache/uv
          key: uv-${{ hashFiles('uv.lock') }}
      - name: Install dependencies
        run: uv sync --frozen --all-extras --python "$(mise which python)"
      - uses: actions/cache@v6
        with:
          path: ~/.cache/pre-commit
          key: pre-commit-${{ hashFiles('.pre-commit-config.yaml') }}
      - name: Lint
        run: mise run lint
      - name: Test
        run: mise run test
      # uv.lock pins Playwright, which pins its Chromium build.
      - uses: actions/cache@v6
        with:
          path: ~/.cache/ms-playwright
          key: playwright-${{ hashFiles('uv.lock') }}
      - name: Install Chromium
        run: uv run python -m playwright install --with-deps chromium
      - name: Browser tests
        run: mise run test-browser
      - name: Prune the uv cache
        run: uv cache prune --ci
{% endraw %}{% if docker %}{% raw %}
  docker:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: docker/setup-buildx-action@v4
      - uses: docker/build-push-action@v7
        with:
          file: docker/Dockerfile
          load: true
{% endraw %}          tags: {{ project_name }}:latest
{% raw %}          cache-from: type=gha
          cache-to: type=gha,mode=max
      # Runs docker/compose.yaml with the image just built, as an operator would.
      # The script prints the compose logs when a check fails.
      - name: Smoke test the compose example
        run: docker/smoke-test.sh
{% endraw %}{% endif %}