from importlib import import_module

from django.apps import AppConfig
{% if "magic_link" in login %}
from django.core import checks
{% endif %}
from django.db.models.signals import post_migrate


class ProjectConfig(AppConfig):
    # The package this module lives in, whatever the project is called.
    name = __name__.rpartition(".")[0]

    def ready(self) -> None:
{% if background_tasks %}
        import_module(f"{self.name}.scheduler_lock").install()
{% endif %}
        log_config = import_module(f"{self.name}.log_config")
        # Here, not in settings: evaluating the settings again would replace the processor list
        # that cached loggers hold.
        log_config.configure()
        log_config.connect()
{% if "magic_link" in login %}
        # A deploy check: the test runner sets DEBUG to False and would trip it.
        checks.register(import_module(f"{self.name}.magic_link").check_settings, deploy=True)
{% endif %}
        cache = import_module(f"{self.name}.cache")
        post_migrate.connect(cache.create_cache_tables, sender=self)
